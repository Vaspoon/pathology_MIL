{
  "version": "0.2.0",
  "configurations": [

    {
    "name": "Debug abmil main.py",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/src/main.py",
    "console": "integratedTerminal",
    "args": [
      "model=transmil",
      "training.lr=1e-4"
     ]
    },
    {
      "name": "Preprocess Patches",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/preprocessing/preprocessing.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}/configs/preprocessing/preprocess_patches.yaml"
      ]
      }

  ]
}